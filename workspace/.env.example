# Variable names only. `npm run db:bootstrap` writes the git-ignored .env.local and .env.test
# with local values (Mailpit SMTP 127.0.0.1:1025, MinIO S3 127.0.0.1:9000). On first setup export
# S3_ACCESS_KEY_ID and S3_SECRET_ACCESS_KEY (the local MinIO values) in the shell. Never commit values.
APP_ENV=
DATABASE_URL=
MIGRATOR_DATABASE_URL=
API_PORT=
API_BIND_HOST=
APP_PUBLIC_URL=
LOG_LEVEL=
AUTH_MODE=
AUTH_SECRET_KEY=
SESSION_COOKIE_NAME=
SESSION_IDLE_MINUTES=
SESSION_ABSOLUTE_HOURS=
PASSWORD_SCRYPT_LOG2N=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_REQUIRE_TLS=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAILPIT_API_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=
FILE_SCANNER=
